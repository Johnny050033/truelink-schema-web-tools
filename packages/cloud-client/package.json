{
  "name": "truelink-schema-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Host-bridge protocol for syncing Schema documents with a TrueLink host: client, host dispatcher and an in-memory reference host.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "truelink-schema-document": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
