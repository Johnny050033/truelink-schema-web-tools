{
  "name": "truelink-schema-web-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Strict object schema validation and isolated static web embeds.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22.13.0" },
  "exports": {
    ".": { "source": "./src/index.ts", "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./schema": { "source": "./src/schema.ts", "types": "./dist/schema.d.ts", "import": "./dist/schema.js" },
    "./embed": { "source": "./src/embed.ts", "types": "./dist/embed.d.ts", "import": "./dist/embed.js" }
  },
  "files": ["dist", "src", "docs", "README.md", "LICENSE", "SECURITY.md"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:build": "node test/build-smoke.mjs",
    "check:core": "pnpm typecheck && pnpm test && pnpm build && pnpm smoke:build",
    "check": "pnpm check:core && pnpm -r run check",
    "dev": "pnpm --filter truelink-schema-studio dev",
    "app:build": "pnpm --filter truelink-schema-studio build",
    "app:preview": "pnpm --filter truelink-schema-studio preview"
  },
  "dependencies": { "css-tree": "3.2.1", "parse5": "8.0.1" },
  "devDependencies": {
    "@types/css-tree": "3.2.0",
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
