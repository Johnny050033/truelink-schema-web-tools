{
  "id": "./",
  "name": "TrueLink Schema Studio",
  "short_name": "Schema Studio",
  "description": "A free, open-source workspace for Schema.org structured data (JSON-LD): build your brand profile, get instant checks and preview what AI assistants can read about your brand. Data stays on your device and works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./#/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f8fafc",
  "theme_color": "#ffffff",
  "categories": [
    "business",
    "productivity",
    "utilities"
  ],
  "icons": [
